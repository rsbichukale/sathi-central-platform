# ============================================================
# SATHI Central Platform - Environment Configuration
# Copy this file to .env and fill in your production values
# ============================================================

# Server
PORT=9090
NODE_ENV=development

# Admin Authentication
# IMPORTANT: Set a strong password in production!
ADMIN_PASSWORD=your_secure_admin_password_here

# JWT Secret (used for all token signing)
# IMPORTANT: Use a long, random string in production!
JWT_SECRET=your_random_jwt_secret_here
JWT_CUSTOMER_EXPIRY=30d
JWT_LICENSE_EXPIRY=7d

# Admin Token Expiry (hours)
ADMIN_TOKEN_EXPIRY_HOURS=24

# Razorpay Payment Gateway
# Get your keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Email & SMTP Server Settings
# Gmail Example: host=smtp.gmail.com, port=587, user=your@gmail.com, pass=your_app_password
# cPanel/Hostinger Example: host=mail.yourdomain.com, port=465, secure=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Ruractive Technology <noreply@ruractive.com>"
ADMIN_NOTIFICATION_EMAIL=support@ruractive.com

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:9090,http://127.0.0.1:9090,https://yourdomain.com

# Logging
LOG_LEVEL=INFO
